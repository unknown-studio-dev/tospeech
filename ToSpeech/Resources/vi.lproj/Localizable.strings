"coach.variant.ɐ" = "/ɐ/: nguyên âm giữa, gần mở, môi không tròn. Trong phiên âm UK, nó có thể biểu diễn STRUT mở hơn /ʌ/. Giữ ký hiệu của mẫu; không suy ra điểm chấm từ quan hệ này.";
"coach.variant.ʔ" = "/ʔ/: chặn luồng hơi ngắn ở thanh môn rồi nhả, như chỗ ngắt trong “uh-oh”. Đây có thể là biến thể của /t/ UK; không đặt đầu lưỡi như /t/. Từ mẫu tổng hợp bên dưới không bảo đảm dùng biến thể này.";
"coach.variant.l̩" = "/l̩/ tự làm hạt nhân âm tiết: giữ đầu lưỡi ở gờ lợi, để hơi qua hai bên mà không cần thêm schwa rõ. Ví dụ cuối bottle; cũng có người dùng /əl/.";
"coach.variant.n̩" = "/n̩/ tự làm hạt nhân âm tiết: đầu lưỡi ở gờ lợi, hơi ra mũi; không cần thêm nguyên âm rõ. Ví dụ cuối button, cũng có biến thể /ən/.";
"coach.variant.m̩" = "/m̩/ tự làm hạt nhân âm tiết: khép môi và ngân hơi ra mũi mà không cần nguyên âm riêng. Ví dụ một cách đọc rhythm; cũng có biến thể /əm/.";
"coach.variant.i" = "/i/ ở âm tiết yếu như cuối happy không buộc dài như /iː/. Giữ lưỡi cao ở trước nhưng đọc nhẹ theo câu.";
"coach.variant.u" = "/u/ trong âm tiết yếu không buộc dài như /uː/. Giữ lưỡi cao, môi tròn nhẹ và đọc nhẹ theo câu.";
"coach.variant.ɛː" = "/ɛː/ là cách thể hiện nguyên âm đơn dài của SQUARE: lưỡi ở trước, hàm mở vừa, không bắt buộc lướt về schwa.";
"coach.variant.ɪː" = "/ɪː/ có thể là cách thể hiện nguyên âm đơn dài của NEAR. Giữ nguyên chất âm, không bắt buộc tách thêm schwa.";
"coach.variant.ʊː" = "/ʊː/ có thể là biến thể nguyên âm đơn dài của CURE. Giữ chất âm /ʊ/ và nghe mẫu của bài; không tự đổi thành /uː/.";

